# Copy to .env (in this folder or the folder one level above) and fill in.
# The app checks this repo folder first, then the parent folder.

# Course key, used only with gpt-6-luna (via Portkey).
PORTKEY_API_KEY=

# Optional fallback if PORTKEY_API_KEY is not set (also uses gpt-6-luna).
OPENAI_API_KEY=

# Optional settings
# SUPERDAY_DAILY_CAP_USD=1.00
# SUPERDAY_DB=data/superday.db
# SUPERDAY_SEED=data/sample_profile.json
